# Upload allowlist: local recordings, credentials and build outputs stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/tools/
/tools/*
!/tools/check-upload.py
!/android-app/
/android-app/*
!/android-app/AndroidManifest.xml
!/android-app/build.ps1
!/android-app/src/
!/android-app/res/
!/android-app/assets/
!/android-app/check-combat-policy.py
!/android-app/check-profile-flow.py
!/android-app/check-entrance-movement.py
!/android-app/check-login-flow.py
!/android-app/check-ultimate-wait.py

# Never publish secrets, device state, raw captures or generated packages.
**/recordings/
**/test-build/
**/build/
**/dist/
**/__pycache__/
**/*.pyc
**/*.class
**/*.apk
**/*.aab
**/*.keystore
**/*.jks
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/.env
**/.env.*
**/local.properties
**/*.log
**/shared_prefs/
**/*credentials*.json
